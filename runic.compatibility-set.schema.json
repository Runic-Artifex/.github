{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic.artifex/schemas/compatibility-set/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "releaseTrainVersion", "publication", "toolchain", "languageProfiles", "platformProfiles", "sources", "contracts", "packages"],
  "properties": {
    "$schema": { "const": "./runic.compatibility-set.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "releaseTrainVersion": { "$ref": "#/$defs/version" },
    "publication": { "const": "forbidden" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnetSdk", "node", "npm"],
      "properties": {
        "dotnetSdk": { "$ref": "#/$defs/numericVersion" },
        "node": { "$ref": "#/$defs/numericVersion" },
        "npm": { "$ref": "#/$defs/numericVersion" }
      }
    },
    "languageProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1", "postV1"],
      "properties": {
        "v1": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/languageProfile" } },
        "postV1": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/languageProfile" } }
      }
    },
    "platformProfiles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contract" } },
    "packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "numericVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-preview\\.[0-9]+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "languageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "role", "state"],
      "properties": {
        "language": { "enum": ["csharp", "typescript-effect", "rust", "cpp"] },
        "role": { "enum": ["application-backend", "frontend", "native-and-backend"] },
        "state": { "enum": ["supported", "unassigned"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "url", "revision"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "url": { "type": "string", "pattern": "^https://github\\.com/Runic-Artifex/[A-Za-z0-9.-]+$" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "path", "algorithm", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9./-]+$" },
        "algorithm": { "const": "sha256-git-file-set-v1" },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "identity", "version", "source"],
      "properties": {
        "ecosystem": { "enum": ["nuget", "npm"] },
        "identity": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
