{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Runic-Artifex/.github/blob/main/runic.ci.schema.json",
  "title": "Runic Artifex CI policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "toolchain",
    "registry",
    "stages",
    "retention"
  ],
  "properties": {
    "$schema": {
      "const": "./runic.ci.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bun", "node", "npmPublisher"],
      "properties": {
        "bun": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "node": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "npmPublisher": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "npm",
        "nuget",
        "candidateMarker",
        "revisionLength"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "npm": {
          "type": "string",
          "format": "uri"
        },
        "nuget": {
          "type": "string",
          "format": "uri"
        },
        "candidateMarker": {
          "const": "-ci.sha"
        },
        "revisionLength": {
          "type": "integer",
          "minimum": 12,
          "maximum": 40
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "repositories", "after"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["materialize", "validate"]
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^runic-[a-z0-9-]+$"
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumAgeDays",
        "expirationGraceDays",
        "keepSuccessfulPerPackage",
        "automaticDeletion"
      ],
      "properties": {
        "minimumAgeDays": {
          "type": "integer",
          "minimum": 1
        },
        "expirationGraceDays": {
          "type": "integer",
          "minimum": 1
        },
        "keepSuccessfulPerPackage": {
          "type": "integer",
          "minimum": 1
        },
        "automaticDeletion": {
          "const": false
        }
      }
    }
  }
}
