{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["_type", "predicateType", "subject", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "predicateType": { "const": "https://runic.artifex/release-evidence-collection/v1" },
    "subject": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "receipts", "created", "verifier"],
      "properties": {
        "manifest": { "$ref": "#/$defs/digest" },
        "receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receipt" } },
        "created": { "type": "string", "minLength": 20 },
        "verifier": { "$ref": "#/$defs/verifier" }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "object", "additionalProperties": false, "required": ["sha256"], "properties": { "sha256": { "$ref": "#/$defs/sha" } } },
    "subject": { "type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": { "name": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["repository", "revision", "tree"], "properties": { "repository": { "type": "string", "minLength": 1 }, "revision": { "$ref": "#/$defs/git" }, "tree": { "$ref": "#/$defs/git" } } },
    "builder": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } },
    "invocation": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } },
    "material": { "type": "object", "additionalProperties": false, "required": ["uri", "sha256"], "properties": { "uri": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "verifier": { "type": "object", "additionalProperties": false, "required": ["version", "binarySha256", "outputSha256"], "properties": { "version": { "const": "2.97.0" }, "binarySha256": { "$ref": "#/$defs/sha" }, "outputSha256": { "$ref": "#/$defs/sha" } } },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "artifactPath", "attestationBundle", "source", "builder", "invocation", "materials"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" },
        "artifactPath": { "type": "string", "minLength": 1 },
        "attestationBundle": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+\\-]*$" }, "sha256": { "$ref": "#/$defs/sha" } } },
        "source": { "$ref": "#/$defs/source" },
        "builder": { "$ref": "#/$defs/builder" },
        "invocation": { "$ref": "#/$defs/invocation" },
        "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/material" } }
      }
    }
  }
}
