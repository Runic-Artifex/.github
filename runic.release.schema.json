{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic.artifex/schemas/release-train/v1",
  "title": "Runic Artifex release-train authority",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "policy", "repositories", "products", "canonicalPackages", "currentPackages", "artifactAuthorities", "formatEvidence", "formatSupport", "compatibilityTrains", "distributions"],
  "properties": {
    "$schema": { "const": "./runic.release.schema.json" }, "schemaVersion": { "const": 1 }, "policy": { "$ref": "#/$defs/policy" },
    "repositories": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/repository" } }, "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/product" } },
    "canonicalPackages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } }, "currentPackages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/currentPackage" } },
    "artifactAuthorities": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/authority" } }, "formatEvidence": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/formatEvidence" } }, "formatSupport": { "type": "array", "items": { "$ref": "#/$defs/format" } },
    "compatibilityTrains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/train" } }, "distributions": { "type": "array", "items": { "$ref": "#/$defs/distribution" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "enum": ["unassigned", "published"] }, "value": { "type": ["string", "null"] } } },
    "releaseVersion": { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "enum": ["unassigned", "published"] }, "value": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["noForwardingPackages", "finalDeprecationRelease", "archivedProductsAreNotReleaseBearing"], "properties": { "noForwardingPackages": { "const": true }, "finalDeprecationRelease": { "const": true }, "archivedProductsAreNotReleaseBearing": { "const": true } } },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "currentIdentity", "v02Identity", "githubRepository", "attestationWorkflow"], "properties": { "id": { "$ref": "#/$defs/id" }, "currentIdentity": { "$ref": "#/$defs/id" }, "v02Identity": { "$ref": "#/$defs/id" }, "githubRepository": { "type": "string", "pattern": "^https://github\\.com/Runic-Artifex/[A-Za-z0-9_.-]+$" }, "attestationWorkflow": { "type": "string", "pattern": "^Runic-Artifex/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" } } },
    "product": { "type": "object", "additionalProperties": false, "required": ["id", "stableOwner", "repository", "support", "documentation"], "properties": { "id": { "$ref": "#/$defs/id" }, "stableOwner": { "$ref": "#/$defs/id" }, "repository": { "$ref": "#/$defs/id" }, "support": { "enum": ["supported", "archived"] }, "documentation": { "$ref": "#/$defs/documentation" }, "archive": { "$ref": "#/$defs/archive" } } },
    "documentation": { "type": "object", "additionalProperties": false, "required": ["state", "path"], "properties": { "state": { "enum": ["available", "pending"] }, "path": { "type": ["string", "null"] } } },
    "archive": { "type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": { "status": { "const": "archived" }, "evidence": { "$ref": "#/$defs/archiveEvidence" } } },
    "archiveEvidence": { "type": "object", "additionalProperties": false, "required": ["repository", "revision", "path"], "properties": { "repository": { "$ref": "#/$defs/id" }, "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" } } },
    "package": { "type": "object", "additionalProperties": false, "required": ["identity", "ecosystem", "installKind", "product", "state"], "properties": { "identity": { "$ref": "#/$defs/id" }, "ecosystem": { "enum": ["nuget", "npm"] }, "installKind": { "enum": ["nuget-package", "dotnet-template", "dotnet-tool", "npm-package"] }, "product": { "$ref": "#/$defs/id" }, "state": { "const": "approved" } } },
    "migration": { "type": "object", "additionalProperties": false, "required": ["kind", "target", "guidance"], "properties": { "kind": { "enum": ["package", "remove"] }, "target": { "type": ["string", "null"] }, "guidance": { "$ref": "#/$defs/id" } } },
    "currentPackage": { "type": "object", "additionalProperties": false, "required": ["identity", "ecosystem", "product", "stableOwner", "support", "disposition", "target", "migration"], "properties": { "identity": { "$ref": "#/$defs/id" }, "ecosystem": { "enum": ["nuget", "npm"] }, "product": { "$ref": "#/$defs/id" }, "stableOwner": { "$ref": "#/$defs/id" }, "support": { "enum": ["supported", "archived"] }, "disposition": { "enum": ["keep", "merge", "internalize", "rename", "retire", "archive"] }, "target": { "type": ["string", "null"] }, "migration": { "$ref": "#/$defs/migration" } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["artifact", "product", "owner", "versioning", "evidence"], "properties": { "artifact": { "$ref": "#/$defs/id" }, "product": { "$ref": "#/$defs/id" }, "owner": { "$ref": "#/$defs/id" }, "versioning": { "enum": ["versioned", "not-yet-versioned"] }, "justification": { "$ref": "#/$defs/id" }, "evidence": { "$ref": "#/$defs/id" } } },
    "authoredSource": { "type": "object", "additionalProperties": false, "required": ["path", "role"], "properties": { "path": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/id" } } },
    "verification": { "type": "object", "additionalProperties": false, "required": ["method", "command"], "properties": { "method": { "type": "string" }, "command": { "type": "string" } } },
    "nullableVersion": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/version" }] },
    "nullableVerification": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/verification" }] },
    "formatEvidence": { "type": "object", "additionalProperties": false, "required": ["id", "artifact", "state", "writer", "readerSupport", "repository", "sources", "verification"], "properties": { "id": { "$ref": "#/$defs/id" }, "artifact": { "$ref": "#/$defs/id" }, "state": { "enum": ["verified", "unverified"] }, "writer": { "$ref": "#/$defs/nullableVersion" }, "readerSupport": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 1 } }, "repository": { "type": ["string", "null"] }, "sources": { "type": ["array", "null"], "items": { "$ref": "#/$defs/authoredSource" } }, "verification": { "$ref": "#/$defs/nullableVerification" } } },
    "format": { "type": "object", "additionalProperties": false, "required": ["artifact", "writer", "readerSupport", "evidence"], "properties": { "artifact": { "$ref": "#/$defs/id" }, "writer": { "$ref": "#/$defs/version" }, "readerSupport": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }, "evidence": { "$ref": "#/$defs/id" } } },
    "laneVersion": { "type": "object", "additionalProperties": false, "required": ["product", "version"], "properties": { "product": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/releaseVersion" } } },
    "lane": { "type": "object", "additionalProperties": false, "required": ["name", "products", "versions"], "properties": { "name": { "enum": ["current", "previous-supported", "next-candidate"] }, "products": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "versions": { "type": "array", "items": { "$ref": "#/$defs/laneVersion" } } } },
    "train": { "type": "object", "additionalProperties": false, "required": ["id", "lanes"], "properties": { "id": { "const": "v1.0" }, "lanes": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/lane" } } } },
    "distribution": { "type": "object", "additionalProperties": false, "required": ["id", "product", "kind", "identity", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "product": { "$ref": "#/$defs/id" }, "kind": { "enum": ["application-archive", "developer-command"] }, "identity": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/releaseVersion" } } }
  }
}
